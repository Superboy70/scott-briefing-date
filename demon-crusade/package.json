{
  "name": "demon-crusade",
  "version": "1.2.0",
  "private": true,
  "description": "마계 성전 - 디아블로2 x 마계촌 스타일 횡스크롤 액션 RPG (Android 13~16)",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "android:init": "npx cap add android && node scripts/patch-android.mjs",
    "android:sync": "npx cap sync android",
    "android:build": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
